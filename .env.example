# Database
DATABASE_URL=postgresql+asyncpg://apiweaver:apiweaver@localhost:5432/apiweaver

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# S3 / MinIO
S3_BUCKET_UPLOADS=apiweaver-uploads
S3_BUCKET_ARTIFACTS=apiweaver-artifacts
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# LLM Providers & Local Models (OpenAI, Gemini, Ollama, Groq, DeepSeek, vLLM)
# - OpenAI:           OPENAI_API_KEY=sk-... OPENAI_API_BASE_URL=https://api.openai.com/v1 LLM_MODEL=gpt-4o-mini
# - Google Gemini:    OPENAI_API_KEY=AIzaSy... OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
# - Ollama (Local):   OPENAI_API_BASE_URL=http://localhost:11434/v1 LLM_MODEL=qwen2.5-coder:7b
# - Groq:             OPENAI_API_KEY=gsk_... OPENAI_API_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
# - DeepSeek:         OPENAI_API_KEY=sk-... OPENAI_API_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-2.0-flash
# Anthropic Claude (Native Messages API)
ANTHROPIC_API_KEY=
# Embeddings (e.g., text-embedding-3-small, nomic-embed-text)
EMBEDDING_MODEL=gemini-embedding-001
MAX_EMBEDDING_CHUNKS=200
EMBEDDING_BASE_URL=

# JWT (RS256) — generate with: openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Per-account lockout (counted on the user row, not the fail-open per-IP Redis limiter)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# GitHub Export (conditional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Sandbox (mock execs LLM code in the API process — local testing only)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MAX_CPU=1
SANDBOX_MAX_MEMORY=1Gi
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK_ENABLED=false

# Observability (recommended)
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUIRE_CELERY_WORKER=true
RUN_MIGRATIONS_ON_STARTUP=true

#Metrics 
METRICS_TOKEN=prod_scrape_token_local_test
