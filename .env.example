# Database
DATABASE_URL=postgresql+asyncpg://apiweaver:apiweaver@localhost:5432/apiweaver
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_WORKFLOW_MAXLEN=1000
REDIS_STREAM_PROJECT_MAXLEN=2000
REDIS_STREAM_WORKFLOW_TTL_SECONDS=86400
REDIS_STREAM_PROJECT_TTL_SECONDS=604800

# Qdrant
QDRANT_URL=http://localhost:6333

# S3 / MinIO
S3_BUCKET_UPLOADS=apiweaver-uploads
S3_BUCKET_ARTIFACTS=apiweaver-artifacts
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# LLM Providers & Local Models (OpenAI, Gemini, Ollama, Groq, DeepSeek, vLLM)
# - OpenAI:           OPENAI_API_KEY=sk-... OPENAI_API_BASE_URL=https://api.openai.com/v1 LLM_MODEL=gpt-4o-mini
# - Google Gemini:    OPENAI_API_KEY=AIzaSy... OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
# - Ollama (Local):   OPENAI_API_BASE_URL=http://localhost:11434/v1 LLM_MODEL=qwen2.5-coder:7b
# - Groq:             OPENAI_API_KEY=gsk_... OPENAI_API_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
# - DeepSeek:         OPENAI_API_KEY=sk-... OPENAI_API_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-2.0-flash
# Anthropic Claude (Native Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
# Embeddings (e.g., text-embedding-3-small, nomic-embed-text)
EMBEDDING_MODEL=gemini-embedding-001
MAX_EMBEDDING_CHUNKS=200
EMBEDDING_BASE_URL=

# Token Budget & Pricing (cost tracking in USD)
DEFAULT_TOKEN_BUDGET=1000000
DEFAULT_TOKEN_PRICE=0.000003
# Custom model pricing JSON map (overrides/extends default table):
# MODEL_PRICING_PER_TOKEN='{"gpt-4o-mini": 0.0000003, "gpt-4o": 0.000005, "gemini-2.0-flash": 0.0000001}'
# Optional workflow progress percentage map override by node name:
# WORKFLOW_NODE_PROGRESS_MAP='{"doc_agent": 15, "planner_agent": 30, "code_agent": 60, "test_agent": 75, "export_agent": 95}'

# JWT (RS256) — generate with: openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Per-account lockout (counted on the user row, not the fail-open per-IP Redis limiter)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# GitHub App & OAuth (conditional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET_VAULT_PATH=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# Sandbox (mock execs LLM code in the API process — local testing only)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MAX_CPU=1
SANDBOX_MAX_MEMORY=1Gi
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK_ENABLED=false

# Observability (recommended)
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUIRE_CELERY_WORKER=true
# Note: Database migrations are executed via the `db-migration` init container / `scripts/migrate.py`, never on API boot.

#Metrics 
METRICS_TOKEN=prod_scrape_token_local_test
