{
  "dashboard": {
    "id": null,
    "title": "APIWeaver — Infrastructure",
    "tags": ["apiweaver"],
    "timezone": "browser",
    "schemaVersion": 16,
    "refresh": "60s",
    "panels": [
      {
        "id": 1,
        "title": "EKS Node CPU Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "avg(rate(container_cpu_usage_seconds_total[5m])) by (node)",
            "legendFormat": "{{node}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "EKS Node Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "avg(container_memory_usage_bytes / container_spec_memory_limit_bytes) by (node)",
            "legendFormat": "{{node}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "PostgreSQL Database Connections",
        "type": "timeseries",
        "targets": [
          {
            "expr": "postgres_database_connections",
            "legendFormat": "{{server}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Redis Hit Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
            "legendFormat": "hit rate %"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 5,
        "title": "Blob Storage Request Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(storage_requests_total[5m])) by (container, type)",
            "legendFormat": "{{container}} {{type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
      }
    ]
  }
}
