# ==============================================================================
# APIWeaver Production Environment Variables (.env.prod)
# SRE Guardrail: Store these in AWS SSM Parameter Store or inject via CI/CD
# ==============================================================================

# Application Core
APP_ENV=production
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=["https://your-frontend-domain.cloudfront.net"]

# Database (From Terraform rds_endpoint output)
# Format: postgresql+asyncpg://<username>:<password>@<rds_endpoint>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://apiweaver_admin:CHANGE_ME_PASSWORD@apiweaver-prod-db.xxxxx.us-east-1.rds.amazonaws.com:5432/apiweaver

# Cache & Celery Message Broker (Internal Redis container)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Application Symmetric Encryption Key (AES-256-GCM, 32-byte base64)
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=dGhpc2lzYTMydnl0ZXNlY3JldGtleWZvcmFlczI1Ng==

# JWT Auth Keys (RS256 PEM paths)
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt_public.pem

# Object Storage (Amazon S3 - IAM Instance Profile automatically authorizes access)
AWS_REGION=ap-south-1
S3_BUCKET_UPLOADS=apiweaver-production-artifacts-123456789012
S3_BUCKET_ARTIFACTS=apiweaver-production-artifacts-123456789012

# Vector DB (Qdrant Cloud Free Tier)
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Sandbox DevSecOps Settings
SANDBOX_BACKEND=docker
DOCKER_HOST=tcp://docker-socket-proxy:2375
SANDBOX_IMAGE=ghcr.io/ajambla/apiweaver/sandbox-python:latest
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_MAX_CPU=1
SANDBOX_MAX_MEMORY=512m
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=300
