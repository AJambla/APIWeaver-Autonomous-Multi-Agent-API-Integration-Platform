# ==============================================================================
# APIWeaver Production Environment Variables (.env.prod)
# SRE Guardrail: Store these in AWS SSM Parameter Store or inject via CI/CD
# ==============================================================================

# Application Core
APP_ENV=production
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=https://black-pond-027edec00.8.azurestaticapps.net

# Database (Internal Docker network: host is "postgres")
# Format: postgresql+asyncpg://<username>:<password>@postgres:5432/<dbname>
POSTGRES_DB=apiweaver
POSTGRES_USER=apiweaver_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://apiweaver_admin:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/apiweaver

# Cache & Celery Message Broker (Internal Redis container)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Application Symmetric Encryption Key (AES-256-GCM, 32-byte base64)
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=dGhpc2lzYTMydnl0ZXNlY3JldGtleWZvcmFlczI1Ng==

# JWT Auth Keys (RS256 PEM paths)
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt_public.pem

# Object Storage (Azure Blob Storage - Managed Identity or Account Name)
STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_NAME=stapiweaver924aa9
AZURE_STORAGE_CONTAINER_ARTIFACTS=artifacts
AZURE_STORAGE_CONTAINER_UPLOADS=uploads
# If using connection string instead of VM Managed Identity:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Vector DB (Qdrant Cloud Free Tier)
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Sandbox DevSecOps Settings
SANDBOX_BACKEND=docker
DOCKER_HOST=tcp://docker-socket-proxy:2375
SANDBOX_IMAGE=ghcr.io/ajambla/apiweaver/sandbox-python:latest
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_MAX_CPU=1
SANDBOX_MAX_MEMORY=512m
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=300
