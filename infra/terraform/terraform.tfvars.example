# ==============================================================================
# APIWeaver Azure for Students Terraform Variables Example
# ==============================================================================

app_name    = "apiweaver"
environment = "production"

# Azure region (indiasouthcentral, eastasia, uaenorth, etc.)
azure_region = "indiasouthcentral"

# VM Size (Standard_B2als_v2 = 2 vCPU, 2 GB RAM AMD64)
vm_size = "Standard_B2als_v2"

# VM Admin Username
admin_username = "azureuser"

# Optional: paste your public SSH key here (e.g., "ssh-ed25519 AAAAC3...").
# If left blank, Terraform will generate a new ED25519 keypair for you.
ssh_public_key = ""

# PostgreSQL Flexible Database
db_name           = "apiweaver"
db_admin_username = "apiweaver_admin"

# If left blank, a random 24-character secure password is generated
db_admin_password = ""

# Auto-Shutdown Schedule (Saves ~50% of student credits by pausing VM at night)
auto_shutdown_enabled  = true
auto_shutdown_time     = "0000" # Midnight
auto_shutdown_timezone = "India Standard Time"
