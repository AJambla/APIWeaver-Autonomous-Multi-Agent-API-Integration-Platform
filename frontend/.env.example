# Public API base URL (rewrites are configured in next.config.js so the browser
# talks to /api/v1 directly; this is only used for SSR/fetch base when needed).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Internal API URL (server-side fetches, bypasses the rewrite when set).
APIWEAVER_API_URL=http://localhost:8000/api/v1
