"""FastMCP Tools generated by APIWeaver for {{ title }}."""
from __future__ import annotations

import json
import os
import urllib.parse
from typing import Any, Optional

import httpx

try:
    from mcp.server.fastmcp import FastMCP
    mcp = FastMCP({{ title | lit }})
except ImportError:
    class _MockMCP:
        def tool(self, *args, **kwargs):
            def decorator(fn):
                fn.__mcp_tool__ = True
                return fn
            return decorator
    mcp = _MockMCP()

DEFAULT_BASE_URL = {{ base_url | lit }}


def _get_base_url() -> str:
    return os.environ.get("API_BASE_URL", DEFAULT_BASE_URL).rstrip("/")


def _get_client() -> httpx.AsyncClient:
    headers = {"Accept": "application/json, text/plain, */*"}
    auth_token = os.environ.get("AUTHORIZATION") or os.environ.get("API_KEY") or os.environ.get("BEARER_TOKEN")
    if auth_token:
        header_val = auth_token if auth_token.startswith("Bearer ") else f"Bearer {auth_token}"
        headers["Authorization"] = header_val
    return httpx.AsyncClient(headers=headers, timeout=30.0)

{% for ep in endpoints %}
{% set op_name = ep.operationId or (ep.method | lower + "_" + (ep.path | replace("/", "_") | replace("{", "") | replace("}", "") | replace("-", "_")) | trim("_")) %}
{% set is_destructive = ep.requires_confirmation or (ep.method | upper == "DELETE") %}

@mcp.tool()
async def {{ op_name }}(
    {% for p in ep.parameters if p.name %}
    {{ p.name }}: {{ p.type | py_type }}{% if not p.required %} = None{% endif %},
    {% endfor %}
    {% if ep.request_schema or ep.method | upper in ["POST", "PUT", "PATCH"] %}
    body: Optional[dict[str, Any]] = None,
    {% endif %}
    {% if is_destructive %}
    confirm: bool = False,
    {% endif %}
) -> dict[str, Any]:
    """{{ ep.summary or (ep.method + " " + ep.path) }}

    Method: {{ ep.method | upper }}
    Path: {{ ep.path }}
    {% if is_destructive %}
    Safety Tier: Destructive (HIGH RISK) - Requires explicit confirmation.
    {% else %}
    Safety Tier: Safe (Low Risk)
    {% endif %}
    """
    {% if is_destructive %}
    if not confirm:
        return {
            "status": "error",
            "code": "CONFIRMATION_REQUIRED",
            "message": "Destructive operation requires explicit confirmation. Set confirm=True to execute.",
        }
    {% endif %}
    base_url = _get_base_url()
    path = {{ ep.path | lit }}
    {% for p in ep.parameters if p.location == "path" and p.name %}
    path = path.replace("{" + {{ p.name | lit }} + "}", urllib.parse.quote(str({{ p.name }})))
    {% endfor %}

    query_params: dict[str, Any] = {}
    {% for p in ep.parameters if p.location == "query" and p.name %}
    if {{ p.name }} is not None:
        query_params[{{ p.name | lit }}] = {{ p.name }}
    {% endfor %}

    url = f"{base_url}{path}"
    async with _get_client() as client:
        try:
            resp = await client.request(
                method={{ ep.method | upper | lit }},
                url=url,
                params=query_params if query_params else None,
                {% if ep.request_schema or ep.method | upper in ["POST", "PUT", "PATCH"] %}
                json=body if body is not None else None,
                {% endif %}
            )
            try:
                data = resp.json()
            except Exception:
                data = resp.text
            return {"status_code": resp.status_code, "data": data, "is_error": resp.is_error}
        except httpx.HTTPStatusError as exc:
            return {"status_code": exc.response.status_code, "error": str(exc), "is_error": True}
        except Exception as exc:
            return {"status_code": 500, "error": str(exc), "is_error": True}
{% endfor %}
