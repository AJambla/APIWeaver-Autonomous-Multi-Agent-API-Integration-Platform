{
  "name": {{ (package_name ~ '-client') | lit }},
  "version": {{ version | lit }},
  "description": {{ ('Auto-generated ' ~ title ~ ' API client for Node.js/TypeScript') | lit }},
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": ["api", "client", "typescript", {{ package_name | lit }}],
  "author": {{ (author_name ~ ' <' ~ author_email ~ '>') | lit }},
  "license": {{ license | lit }},
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}