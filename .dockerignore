# Version control
.git
.gitignore

# Environment files
# Bare patterns match only from the context root and `*` does not cross `/` (measured on BuildKit,
# Docker 29.7.2), so the `**/` lines are not duplicates: they are what keeps a nested
# `backend/.env` out of the agent-worker image, which does `COPY backend ./backend`.
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*

# Secrets and keys
secrets/
*.pem
*.key
**/secrets/
**/*.pem
**/*.key

# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info
*.pyo
**/__pycache__/

# Virtual environments
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# Test and cache directories
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Logs
*.log

# OS-generated files
.DS_Store
Thumbs.db

# IDE and editor files
.idea/
.vscode/
*.swp
*~

# Documentation and non-essential files
Project-docs/
monitoring/
infra/terraform/
**/README.md
**/README.txt
**/*.md

# Frontend (not needed for backend/agent-worker builds)
frontend/
frontend-*/

# Scripts and CI/CD
scripts/
.github/

# Kilo config
.kilo/

# Database migrations (alembic) - not needed for agent-worker
backend/alembic/

# Local development
*.local
*.dev
