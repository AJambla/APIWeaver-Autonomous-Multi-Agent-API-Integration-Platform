# Version control
.git
.gitignore
.gitattributes
.github/

# Environment files
# Bare patterns match only from the context root and `*` does not cross `/` (measured on BuildKit,
# Docker 29.7.2), so the `**/` lines are not duplicates: they are what keeps a nested
# `backend/.env` out of the agent-worker image, which does `COPY backend ./backend`.
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*

# Secrets and keys
secrets/
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
**/secrets/
**/*.pem
**/*.key
**/*.crt
**/*.cert
**/*.pfx
**/*.p12

# Dependencies
node_modules/
**/node_modules/

# Build outputs & frontend dist
.next/
dist/
build/
.turbo/
.vercel
.vite/
**/dist/
**/build/
**/node_modules/
frontend/dist/
Frontend/dist/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info
*.pyo
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.egg-info/

# Virtual environments
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# Test and cache directories
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.cache/
.tox/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/

# Logs
logs/
*.log
**/*.log

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

